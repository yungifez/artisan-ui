{
    "name": "yungifez/april-ui",
    "description": "A livewire blade UI component library",
    "keywords": [
        "yungifez",
        "laravel",
        "april-ui"
    ],
    "homepage": "https://github.com/yungifez/april-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Marvellous",
            "email": "ifezueyoung@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.14.0",
        "illuminate/contracts": "^12.0|^13.0",
        "tales-from-a-dev/tailwind-merge-php": "^0.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "mallardduck/blade-lucide-icons": "^2.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-arch": "^3.1|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Yungifez\\AprilUI\\": "src/",
            "Yungifez\\AprilUI\\Database\\Factories\\": "database/factories/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Yungifez\\AprilUI\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-april-ui --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yungifez\\AprilUI\\AprilUIServiceProvider"
            ],
            "aliases": {
                "AprilUI": "Yungifez\\AprilUI\\Facades\\AprilUI"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
