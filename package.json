{
    "name": "april-ui",
    "version": "1.0.0",
    "description": "April UI JavaScript assets for Laravel Blade and Livewire.",
    "main": "dist/april.js",
    "module": "dist/april.esm.js",
    "exports": {
        ".": {
            "import": "./dist/april.esm.js",
            "default": "./dist/april.js"
        },
        "./dist/*": "./dist/*",
        "./resources/*": "./resources/*",
        "./core": "./resources/js/april-core.js",
        "./livewire": "./resources/js/livewire.js"
    },
    "author": "yungifez",
    "scripts": {
        "build": "node ./scripts/build.js",
        "watch": "node ./scripts/build.js --watch",
        "test:browser": "playwright test"
    },
    "devDependencies": {
        "@alpinejs/anchor": "^3.17.1",
        "@alpinejs/collapse": "^3.17.1",
        "@alpinejs/focus": "^3.17.1",
        "@playwright/test": "^1.62.1",
        "alpinejs": "^3.17.1",
        "autoprefixer": "^10.4.19",
        "brotli-size": "^4.0.0",
        "esbuild": "^0.28.2",
        "postcss": "^8.5.26",
        "postcss-import": "^16.1.0",
        "tailwindcss": "^4.0.9"
    },
    "dependencies": {
        "@tiptap/core": "^3.30.3",
        "@tiptap/extension-placeholder": "^3.30.3",
        "@tiptap/starter-kit": "^3.30.3",
        "date-fns": "^3.6.0"
    },
    "license": "MIT"
}
